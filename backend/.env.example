# Copy to backend/.env for LOCAL development only. On Render, set these in the service's Environment tab.
# NEVER commit a real .env file. NEVER paste real values into issues, chats or screenshots.

# --- required -------------------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres      # Supabase: Project Settings > Database > Connection string (use the pooler URL on Render)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=                                              # Supabase > Project Settings > API (anon / public key)
SUPABASE_SERVICE_ROLE_KEY=                                      # SERVER ONLY. Full access. Never put this in the frontend or in Vercel.
INVITE_PEPPER=                                                  # 24+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHEET_ID=                                                       # the long id in the Google Sheet URL (between /d/ and /edit)
GOOGLE_CLIENT_EMAIL=                                            # service account email; share the sheet with it (Viewer is enough)
GOOGLE_PRIVATE_KEY=                                             # the service account private key; keep the \n sequences, wrap in double quotes
ALLOWED_ORIGINS=https://YOUR-FRONTEND.vercel.app                # comma-separated list of frontend origins allowed to call the API

# --- strongly recommended -------------------------------------------------------------------------
NODE_ENV=production
APP_URL=https://YOUR-FRONTEND.vercel.app                        # used in the links inside invitation emails (defaults to the first ALLOWED_ORIGINS entry)
ACTIVE_COHORT_NUMBER=10                                         # registrations are imported ONLY for this cohort's sheet tab ("Cohort 10 Grading"). Leave unset to allow any cohort.
DATABASE_SSL=verify                                             # verify | no-verify | disable.  Use "verify" once you have confirmed the connection works; "no-verify" was the old behaviour.

# --- email (Resend). Nothing is sent until MAIL_DRY_RUN=false AND both keys are set ----------------
RESEND_API_KEY=
EMAIL_FROM=FUSE Varsity <no-reply@your-verified-domain.com>
MAIL_DRY_RUN=true                                               # set to false to actually send. (REMINDERS_DRY_RUN is the old name and still works.)

# --- optional tuning ------------------------------------------------------------------------------
# PORT=3001                 (Render sets this for you)
# TRUST_PROXY_HOPS=2        (Vercel proxy + Render proxy; leave as is)
# DB_POOL_MAX=10
# MAIL_SEND_DELAY_MS=600    (pause between emails to respect the provider's rate limit)
# LOG_LEVEL=info            (debug | info | warn | error)

# --- one-off, only when running `npm run seed:admin`; remove from the environment afterwards -------
# ADMIN_EMAIL=
# ADMIN_INITIAL_PASSWORD=   (12+ characters; the admin is forced to change it at first login)

# --- tests only: a LOCAL database whose name contains "test". The test suite wipes it. -------------
# TEST_DATABASE_URL=postgres://user:pass@127.0.0.1:5432/fuse_test
